---
import Layout from '../../../layouts/Layout.astro';
import PlotFigure from "../../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import cars from "../../../assets/cars.json";

// Génération statique des chemins au moment du build
export function getStaticPaths() {
  const years = [...new Set(cars.map((c: any) => c.year))];
  return years.map((y) => ({
    params: { year: y.toString() }
  }));
}

const { year } = Astro.params;
const filteredCars = cars.filter((car: any) => car.year.toString() === year);

const plotOptions = {
  grid: true, inset: 10,
  x: { label: "Poids (lb)" },
  y: { label: "Puissance (hp)" },
  title: `Relation Puissance vs Poids - Voitures ${year}`,
  marks: [
    Plot.frame({ stroke: "#e2e8f0" }),
    // CORRECTION ICI : On utilise le code hexadécimal de l'amber Tailwind (#f59e0b)
    Plot.dot(filteredCars, { x: "weight (lb)", y: "power (hp)", fill: "#f59e0b", r: 5 })
  ]
};
---

<Layout title={`Voitures - ${year}`}>
  <div class="max-w-4xl mx-auto p-8 bg-white rounded-2xl border border-slate-200/80 shadow-sm mt-12 mb-12">
    <div class="flex items-center justify-between mb-6 border-b border-slate-100 pb-6">
      <div>
        <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-700 mb-2 inline-block">SSG (getStaticPaths)</span>
        <h1 class="text-2xl font-extrabold text-slate-900">Modèles de l'année {year}</h1>
      </div>
      <a href="/cars/year" class="text-xs font-semibold px-4 py-2.5 rounded-xl bg-amber-50 text-amber-700 transition">← Retour Liste</a>
    </div>
    
    <p class="mb-6 text-sm text-slate-600 bg-slate-50 p-3 rounded-lg border border-slate-200 inline-block">
      {filteredCars.length} voiture(s) trouvée(s) pour l'année {year}
    </p>

    <div class="bg-slate-50/50 rounded-2xl border border-slate-200/80 p-6">
      <PlotFigure options={plotOptions} />
    </div>
  </div>
</Layout>