---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Accueil - TP6 Astro">
  <div class="max-w-5xl mx-auto p-8 bg-white rounded-2xl border border-slate-200/80 shadow-sm mt-12 mb-12">
    
    <div class="text-center mb-12 border-b border-slate-100 pb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-slate-100 text-slate-700 mb-4">
          TP 6 • Astro & Observable Plot
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-4">
          Génération Statique & Routage
        </h1>
        <p class="text-slate-600 text-lg max-w-2xl mx-auto">
          Ce tableau de bord regroupe les deux méthodes du TP : l'affichage dynamique via des onglets sur une même page, et la génération de pages distinctes avec <code>getStaticPaths</code>.
        </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="flex items-center justify-center w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 font-bold">1</div>
          <h2 class="text-lg font-bold text-slate-800">Boucle & Onglets (Même page)</h2>
        </div>
        
        <div class="space-y-4">
          <a href="/penguins-boucle" class="block p-5 bg-indigo-50/50 rounded-xl border border-indigo-100/80 hover:border-indigo-300 hover:shadow-md transition group">
            <h3 class="text-base font-semibold text-indigo-800 mb-1 flex justify-between items-center">
              Pingouins (Toutes les espèces)
              <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span>
            </h3>
            <p class="text-sm text-slate-600">Génération automatique des onglets avec <code>[...new Set()]</code>.</p>
          </a>

          <a href="/cars-boucle" class="block p-5 bg-amber-50/50 rounded-xl border border-amber-100/80 hover:border-amber-300 hover:shadow-md transition group">
            <h3 class="text-base font-semibold text-amber-800 mb-1 flex justify-between items-center">
              Voitures (Toutes les années)
              <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span>
            </h3>
            <p class="text-sm text-slate-600">Même logique appliquée au dataset des voitures.</p>
          </a>
        </div>
      </div>

      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="flex items-center justify-center w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 font-bold">2</div>
          <h2 class="text-lg font-bold text-slate-800">Routage paramétrique (SSG)</h2>
        </div>
        
        <div class="space-y-4">
          <!-- Lien Voitures par Année -->
          <a href="/cars/year" class="block p-5 bg-amber-50/50 rounded-xl border border-amber-100/80 hover:border-amber-300 hover:shadow-md transition group">
            <h3 class="text-base font-semibold text-amber-800 mb-1 flex justify-between items-center">
              Index : Voitures par année
              <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span>
            </h3>
            <p class="text-sm text-slate-600">Génération de multiples pages via <code>getStaticPaths</code>.</p>
          </a>

          <a href="/penguins/island" class="block p-5 bg-emerald-50/50 rounded-xl border border-emerald-100/80 hover:border-emerald-300 hover:shadow-md transition group">
            <h3 class="text-base font-semibold text-emerald-800 mb-1 flex justify-between items-center">
              Index : Pingouins par Île
              <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span>
            </h3>
            <p class="text-sm text-slate-600">Application du routage statique à l'autre dataset.</p>
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>